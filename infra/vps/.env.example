# Render-only defaults. Do not use these values on a public host.
DEPLOYLITE_PUBLIC_HOST=deploylite.invalid
DEPLOYLITE_ACME_EMAIL=invalid@example.invalid
# Optional per-project P3 inspection/network attachment opt-in; unset or empty disables it.
# Bind only existing project IDs to the configured DEPLOYLITE_AGENT_ID.
# DEPLOYLITE_COMPOSE_RESOURCE_PROJECT_AGENTS_JSON='[{"projectId":"project-id","agentId":"agent-id"}]'
POSTGRES_PASSWORD=change-before-runtime
DATABASE_URL=postgres://deploylite:change-before-runtime@postgres:5432/deploylite
POSTGRES_DB=deploylite
POSTGRES_USER=deploylite

# Optional existing source/destination allowlist. Source roots require explicit provisioning.
# Destinations must be the dedicated agent anchor or private owned descendants; existing volumes are never repaired.
# DEPLOYLITE_COMPOSE_VOLUME_BACKUP_ROOTS={"sourceRoots":{"volume":"/explicit/source"},"destinations":{"private":"/var/lib/deploylite-agent/backups"}}
