{
  "name": "deploylite",
  "version": "0.1.0",
  "description": "Lightweight self-hosted deployment control plane for AI-assisted VPS workflows.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "ci:local:evidence": "node scripts/ci/local-ci-evidence-bridge.mjs",
    "ci:local:evidence:test": "node --test scripts/ci/local-evidence/*.test.mjs",
    "runtime:contract": "bash scripts/runtime-contract.test.sh",
    "ci:evidence:check": "node scripts/ci/collect-evidence.mjs --check-only",
    "ci:vitest:forbid-only": "node scripts/ci/vitest-forbid-only.test.mjs",
    "test:docker-dry-run": "pnpm --filter @deploylite/agent build && pnpm --filter @deploylite/agent docker-dry-run"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "find-my-way": "9.7.0",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "sharp": "0.35.0",
      "undici": "7.29.0"
    }
  }
}
